{
  "id": "video-gram",
  "name": "Video-Gram",
  "version": "1.1.0",
  "apiVersion": 14,
  "entry": "plugin.js",
  "description": "Tus videos de Telegram en Kino: los de tus canales y chats, con tu propio bot o tu cuenta (solo lectura). No oficial: sin relación con Telegram. (Your Telegram videos in Kino, with your own bot or your account, read only. Unofficial: not affiliated with Telegram.)",
  "author": "kinotvapp",
  "homepage": "https://github.com/kinotvapp/kino-plugin-video-gram",
  "hosts": [
    "pluto.web.telegram.org",
    "venus.web.telegram.org",
    "aurora.web.telegram.org",
    "vesta.web.telegram.org",
    "flora.web.telegram.org"
  ],
  "capabilities": [
    "home",
    "search",
    "browse",
    "scopedSearch",
    "resolve",
    "socket",
    "byteSource",
    "catalog",
    "imageSource",
    "screen"
  ],
  "categories": [
    "movies"
  ],
  "color": "#E8894A",
  "section": {
    "label": "Video-Gram",
    "labelEn": "Video-Gram"
  },
  "theme": {
    "accent": "#E8894A",
    "onAccent": "#1C1006",
    "background": "#14100D",
    "surface": "#211A15",
    "highlight": "#F4B183"
  },
  "settings": [
    {
      "key": "access",
      "type": "select",
      "label": "Conectar con",
      "labelEn": "Connect with",
      "default": "bot",
      "options": [
        {
          "value": "bot",
          "label": "Un bot en mis canales",
          "labelEn": "A bot in my channels"
        },
        {
          "value": "account",
          "label": "Mi cuenta (solo lectura)",
          "labelEn": "My account (read only)"
        }
      ],
      "hint": "Un bot en tus canales, o tu cuenta en solo lectura",
      "hintEn": "A bot in your channels, or your account read only"
    },
    {
      "key": "api_id",
      "type": "password",
      "label": "api_id",
      "labelEn": "api_id",
      "hint": "Solo números, de my.telegram.org",
      "hintEn": "Digits only, from my.telegram.org"
    },
    {
      "key": "api_hash",
      "type": "password",
      "label": "api_hash",
      "labelEn": "api_hash",
      "hint": "32 letras y números de my.telegram.org",
      "hintEn": "32 letters and digits from my.telegram.org"
    },
    {
      "key": "bot_token",
      "type": "password",
      "label": "Token del bot",
      "labelEn": "Bot token",
      "hint": "Solo con bot: el que da @BotFather, 123456:ABC...",
      "hintEn": "Bot only: the one @BotFather gives, 123456:ABC..."
    },
    {
      "key": "ch1",
      "type": "toggle",
      "label": "Mostrar el lugar 1",
      "labelEn": "Show place 1",
      "default": true
    },
    {
      "key": "ch2",
      "type": "toggle",
      "label": "Mostrar el lugar 2",
      "labelEn": "Show place 2",
      "default": false
    },
    {
      "key": "ch3",
      "type": "toggle",
      "label": "Mostrar el lugar 3",
      "labelEn": "Show place 3",
      "default": false
    },
    {
      "key": "ch4",
      "type": "toggle",
      "label": "Mostrar el lugar 4",
      "labelEn": "Show place 4",
      "default": false
    },
    {
      "key": "ch5",
      "type": "toggle",
      "label": "Mostrar el lugar 5",
      "labelEn": "Show place 5",
      "default": false
    },
    {
      "key": "ch6",
      "type": "toggle",
      "label": "Mostrar el lugar 6",
      "labelEn": "Show place 6",
      "default": false
    },
    {
      "key": "tmdb",
      "type": "toggle",
      "label": "Buscar pósters en TMDB",
      "labelEn": "Look up posters on TMDB",
      "default": true,
      "hint": "Envía el nombre de cada video a TMDB por Kino",
      "hintEn": "Sends each video's name to TMDB through Kino"
    }
  ],
  "screen": {
    "label": "Video-Gram",
    "labelEn": "Video-Gram",
    "opensFrom": [
      "settings"
    ],
    "settingsIn": "screen",
    "settingsButton": {
      "label": "Configurar Video-Gram",
      "labelEn": "Set up Video-Gram"
    }
  },
  "signature": {
    "authorKey": "82b87b938e0a95b142467c815a8823cb54310a13a828c3c4c77b1eda43294ae6",
    "value": "7c524ddd6936660006389a5b13675fe1341d08371798d424553877d5e092184ece36a1ee5c9ab99890456d1a429fc7d5e824568965129059328b078a3d46e000"
  }
}
